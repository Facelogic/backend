NODE_ENV=development
PORT=3000

# PostgreSQL — use DATABASE_URL in Vercel (Neon/Supabase pooled URL) or the DB_* vars locally
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reconofacial
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=5

# Redis (BullMQ). Optional for the API; required for the worker. Upstash: rediss://default:pass@host:6379
REDIS_URL=redis://localhost:6379

# Object storage (S3 / MinIO / R2 compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reconofacial-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES=900
