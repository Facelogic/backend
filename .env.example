NODE_ENV=development
PORT=3000

# Swagger UI at /api/docs (false to disable)
SWAGGER_ENABLED=true

# PostgreSQL — use FACELOIGC_DATABASE_URL in Vercel (Neon/Supabase pooled URL) or the DB_* vars locally
# FACELOIGC_DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
FACELOIGC_POSTGRES_HOST=localhost
DB_PORT=5432
DB_NAME=reconofacial
FACELOIGC_POSTGRES_USER=postgres
FACELOIGC_PGPASSWORD=postgres
DB_SSL=false
DB_POOL_MAX=5

# Redis (BullMQ). Optional for the API; required for the worker. Upstash: rediss://default:pass@host:6379
REDIS_URL=redis://localhost:6379

# Object storage (S3 / MinIO / R2 compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reconofacial-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_EXPIRES=900

# Production (Vercel) with Cloudflare R2 — set these in Vercel → Settings → Environment Variables.
# Create an R2 API token with "Object Read & Write" scoped to the bucket, and add a CORS policy
# on the bucket allowing PUT/GET from your frontend origin (browsers upload via presigned URLs).
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=reconofacial-media
# S3_ACCESS_KEY=<r2-access-key-id>
# S3_SECRET_KEY=<r2-secret-access-key>
# S3_FORCE_PATH_STYLE=true

# Auth — opaque bearer tokens stored hashed in "Session"
SESSION_TTL_HOURS=12
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
# Session cookie (httpOnly). Defaults: name "session"; Secure + SameSite=None in production, SameSite=Lax otherwise.
# AUTH_COOKIE_NAME=session
# AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_SAMESITE=none
# AUTH_COOKIE_DOMAIN=

# Frontend origins allowed to send the cookie (comma-separated). Required in production; empty = any origin in dev.
CORS_ORIGINS=http://localhost:5173
# Production: CORS_ORIGINS=https://tu-frontend.vercel.app,http://localhost:5173

# Seeder for the first SUPERADMIN (npm run db:seed)
SEED_ADMIN_EMAIL=admin@reconofacial.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Super Admin
