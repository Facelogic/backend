{
  "name": "reconofacial-backend",
  "version": "1.0.0",
  "description": "API backend ReconoFacial",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "worker": "node src/workers/media.worker.js",
    "vercel:dev": "vercel dev",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "db:models": "node scripts/generate-models.js"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/lib-storage": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "bullmq": "^6.5.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pgvector": "^0.3.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "sequelize-cli": "^6.6.5",
    "vercel": "^65.8.0"
  },
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.27.0": true,
    "koffi@3.3.3": true,
    "msgpackr-extract": false
  }
}
