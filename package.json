{
  "name": "reconofacial-backend",
  "version": "1.0.0",
  "description": "API backend ReconoFacial",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev": "node --watch src/server.ts",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:create": "node scripts/new-migration.ts",
    "db:seed": "sequelize-cli db:seed:all",
    "db:seed:create": "node scripts/new-seed.ts",
    "worker": "node src/workers/media.worker.ts",
    "vercel:dev": "vercel dev",
    "deploy": "vercel deploy",
    "deploy:prod": "vercel deploy --prod",
    "db:models": "node scripts/generate-models.ts",
    "typecheck": "tsc"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1160.0",
    "@aws-sdk/lib-storage": "^3.1160.0",
    "@aws-sdk/s3-request-presigner": "^3.1160.0",
    "@types/express-form-data": "^2.0.5",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-form-data": "^3.0.1",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "pgvector": "^0.3.0",
    "sequelize": "^6.37.8",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/swagger-ui-express": "^4.1.8",
    "sequelize-cli": "^6.6.5",
    "typescript": "^7.0.2",
    "vercel": "^65.8.0"
  },
  "private": true,
  "engines": {
    "node": "26.x"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "esbuild@0.27.0": true,
    "koffi@3.3.3": true,
    "msgpackr-extract": false,
    "@scarf/scarf": false
  }
}
